# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...        # Socket Mode 사용 시
USE_SOCKET_MODE=false           # 서버리스(Vercel)면 false + HTTP Request URL
# 접근 제한: 비우면 '등록된 임직원 전부' 허용. 값이 있으면 그 slack_user_id만 허용
SLACK_ALLOWLIST=                # 예: U2041,U2044,U3001

# DB / 큐 (관리형 서비스 권장: Neon/Supabase Postgres, Upstash Redis)
DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
REDIS_URL=redis://default:pass@host:6379/0

# 관리자 웹
JWT_SECRET=please-change
CORS_ORIGINS=https://your-app.vercel.app

# Google Calendar (연차 자동 등록)
GCAL_ENABLED=false
GCAL_TEAM_CALENDAR_ID=your_team_calendar@group.calendar.google.com
GCAL_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# 근무 기본값
DEFAULT_CHECKIN=09:00
DEFAULT_CHECKOUT=18:00
REMIND_AFTER_MIN=30
